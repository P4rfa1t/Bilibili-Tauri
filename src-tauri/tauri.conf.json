{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bilibili-Tauri",
  "version": "0.1.0",
  "identifier": "io.github.bilitauri.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bilibili-Tauri",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": true,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Bilibili-Tauri",
    "copyright": "Copyright © 2026 Bilibili-Tauri contributors",
    "category": "Entertainment",
    "shortDescription": "轻量级哔哩哔哩桌面客户端",
    "longDescription": "基于 Tauri 2、Rust 与 WebView2 构建的轻量级哔哩哔哩桌面客户端，支持视频、番剧、弹幕、评论、历史、收藏与稍后再看。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
